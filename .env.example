# Telegram Bot API token issued by BotFather.
TELEGRAM_BOT_TOKEN=FAKE_TELEGRAM_BOT_TOKEN_FOR_TEST

# Telegram user ID that may run administrator commands.
ADMIN_USER_ID=123456789

# Comma-separated Telegram user IDs allowed to use the bot. Empty denies everyone.
ALLOWED_USER_IDS=

# Gemini __Secure-1PSID cookie. Replace this explicit test value only in your local .env.
GEMINI_SECURE_1PSID=FAKE_1PSID_FOR_TEST

# Gemini __Secure-1PSIDTS cookie. Replace this explicit test value only in your local .env.
GEMINI_SECURE_1PSIDTS=FAKE_1PSIDTS_FOR_TEST

# Writable location used to persist refreshed Gemini cookies, and the
# /setcookie override that survives a restart.  Relative to the working
# directory, so under systemd this resolves inside StateDirectory rather than
# where you might expect -- set an absolute path there, and make sure it is the
# one the unit file names.  Losing this directory loses the session.
GEMINI_COOKIE_PATH=./data/cookies

# Optional HTTP/SOCKS proxy URL for Gemini requests; leave empty for no proxy.
GEMINI_PROXY=

# Optional Gemini model name; leave empty to use the account default and dynamic model discovery.
DEFAULT_MODEL=

# Language for administrator and research notifications without chat preference
# state (en or zh-hant).
DEFAULT_LANGUAGE=en

# Maximum number of Gemini requests processed concurrently; keep at 1 by default.
MAX_CONCURRENCY=1

# Maximum requests accepted from one user per minute.
USER_RATE_LIMIT_PER_MIN=10

# Maximum time, in seconds, to wait for a Deep Research task.
RESEARCH_TIMEOUT_SEC=900

# Python logging level: CRITICAL, ERROR, WARNING, INFO, or DEBUG.
LOG_LEVEL=INFO

# Explicit opt-in for high-egress video generation; disabled by default.
ENABLE_VIDEO_GENERATION=false

# Explicit opt-in for high-egress audio generation; disabled by default.
ENABLE_AUDIO_GENERATION=false
